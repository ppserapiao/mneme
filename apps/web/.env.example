# Site URL override. When mneme.dev is provisioned, set this to
# https://mneme.dev on Vercel. Until then, leave unset — the layout.tsx
# metadataBase falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
# NEXT_PUBLIC_SITE_URL=

# Self-hosted analytics (apps/web/lib/analytics.ts).
#
# All three are required for analytics to record events; if any is unset,
# /api/event silently accepts and discards (the landing never breaks).
#
# DATABASE_URL — Postgres connection string. Neon free tier works.
#                See apps/web/scripts/init-analytics.sql for the schema.
# ANALYTICS_SALT — long random string. Used to salt the daily visitor
#                  hash. Rotate to invalidate all prior visitor_hash
#                  values; never share with the client.
# ADMIN_TOKEN — shared secret. Visit /admin?token=$ADMIN_TOKEN. Anything
#               else returns 404. Rotate if leaked.
# DATABASE_URL=postgres://...
# ANALYTICS_SALT=
# ADMIN_TOKEN=
