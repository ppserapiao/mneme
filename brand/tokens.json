{
  "$schema": "https://schemas.mneme.dev/tokens-v1.json",
  "brand": "mneme",
  "color": {
    "ink": { "value": "#15110F", "use": "primary text on paper" },
    "ink-soft": { "value": "#3D342C", "use": "secondary text" },
    "ink-mute": { "value": "#8A7A6A", "use": "labels, captions" },
    "ink-line": { "value": "#D9CFBD", "use": "hairline rules" },
    "paper": { "value": "#F2ECE0", "use": "primary background" },
    "paper-2": { "value": "#EBE3D4", "use": "card / inset" },
    "paper-3": { "value": "#E2D8C5", "use": "pressed" },
    "cream": { "value": "#FAF6EE", "use": "lift, dialog bg" },
    "orange": { "value": "#E0651D", "use": "primary accent, action" },
    "orange-deep": { "value": "#B8481A", "use": "hover / pressed" },
    "orange-soft": { "value": "#F3A06B", "use": "tint" },
    "orange-wash": { "value": "#FBE1CB", "use": "badge background" },
    "ink-bg": { "value": "#1A1714", "use": "primary dark surface" },
    "ink-bg-2": { "value": "#221E1A", "use": "dark card" },
    "ink-bg-3": { "value": "#2C2722", "use": "dark hover" },
    "on-ink": { "value": "#F2ECE0", "use": "text on dark" },
    "on-ink-mute": { "value": "#AD9A82", "use": "secondary text on dark" },
    "good": { "value": "#4F7A4A" },
    "warn": { "value": "#C28A1E" },
    "bad": { "value": "#B23A2A" }
  },
  "font": {
    "display": {
      "stack": "Instrument Serif, Newsreader, Georgia, serif",
      "source": "google",
      "weights": [400]
    },
    "serif": {
      "stack": "Newsreader, Georgia, Times New Roman, serif",
      "source": "google",
      "weights": [400, 500]
    },
    "sans": {
      "stack": "Space Grotesk, system-ui, sans-serif",
      "source": "google",
      "weights": [400, 500, 600]
    },
    "mono": {
      "stack": "JetBrains Mono, ui-monospace, monospace",
      "source": "google",
      "weights": [400, 500]
    }
  },
  "fontImport": "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Newsreader:ital,wght@0,400;0,500;1,400&family=Space+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap",
  "text": {
    "xs": { "size": 11, "use": "labels, meta" },
    "sm": { "size": 13, "use": "UI body, captions" },
    "base": { "size": 16, "use": "default body" },
    "lg": { "size": 19, "use": "lead paragraph" },
    "xl": { "size": 24, "use": "card title" },
    "2xl": { "size": 32, "use": "section heading" },
    "3xl": { "size": 44, "use": "page heading" },
    "4xl": { "size": 64, "use": "display" },
    "5xl": { "size": 96, "use": "hero display" }
  },
  "tracking": {
    "tight": "-0.025em",
    "snug": "-0.015em",
    "normal": "0",
    "wide": "0.06em",
    "wider": "0.22em"
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "9": 96,
    "10": 128
  },
  "radius": { "sm": 4, "md": 8, "lg": 14, "xl": 22, "pill": 999 },
  "motion": {
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)",
    "dur-fast": "120ms",
    "dur-base": "200ms",
    "dur-slow": "360ms"
  },
  "logo": {
    "mark": "assets/mneme-mark.svg",
    "inverse": "assets/mneme-mark-inverse.svg",
    "mono": "assets/mneme-mark-mono.svg",
    "lockup": "assets/mneme-lockup-horizontal.svg",
    "wordmark": "assets/mneme-wordmark.svg",
    "clearspace": "Minimum clearspace = the height of one stack-bar (≈14% of mark height) on all sides.",
    "minSize": { "favicon": 16, "ui": 24, "print": "10mm" }
  }
}
