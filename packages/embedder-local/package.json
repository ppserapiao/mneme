{
  "name": "@mneme/embedder-local",
  "version": "0.1.0",
  "description": "On-device embeddings for @mneme/sdk via @huggingface/transformers. Zero-config local mode with Xenova/all-MiniLM-L6-v2.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "peerDependencies": {
    "@mneme/sdk": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "peerDependencies": {
      "@mneme/sdk": "^0.1.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ppserapiao/mneme.git",
    "directory": "packages/embedder-local"
  },
  "keywords": ["mneme", "embeddings", "local-first", "transformers", "onnx", "semantic-search"]
}
