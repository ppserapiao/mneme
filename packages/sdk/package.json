{
  "name": "@mneme/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for the Mneme Protocol — local-first, user-sovereign memory for AI apps.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mneme/protocol": "workspace:*",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "ulid": "^2.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mneme-dev/mneme.git",
    "directory": "packages/sdk"
  },
  "keywords": ["mneme", "memory", "ai", "sdk", "local-first", "sqlite"]
