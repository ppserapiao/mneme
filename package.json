    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "publint": "^0.3.21",
    "tsdown": "^0.22.0",
    "typescript": "^5.7.2",
    "unrun": "^0.3.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
