{
  "name": "mneme",
  "version": "0.0.0",
  "private": true,
  "description": "The open, user-sovereign memory layer for AI.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "tests/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
